# Copy to .env and fill in. Never commit .env.
# Admin panel password (16+ characters). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=
# Signs login sessions (32+ characters). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Optional locally: a random one is created in instance/. Required in production (Vercel).
AUTH_SECRET=
# Optional for local SQLite runs. Ignored when DATABASE_URL is set.
LEARNMOTION_DB=
# PostgreSQL URL for persistent accounts/progress. Vercel storage integrations can populate this.
# Keep credentials private; use the provider's pooled connection URL when available.
DATABASE_URL=
# Supported alias for Vercel Postgres integrations that expose this name.
POSTGRES_URL=
# Optional: live AI tutor key, held only on the server.
OPENROUTER_API_KEY=
# Optional canonical HTTPS origin used in social preview metadata when publicly hosted.
PUBLIC_APP_URL=
